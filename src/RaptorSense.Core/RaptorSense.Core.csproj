<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- WASAPI loopback capture for the music effects (Windows only). -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <!-- AcerGamingFunction WMI calls for fans and power profiles (Windows only). -->
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RaptorSense.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The app's words in other languages: "English": "translation" pairs, read by Localization/Text.cs. -->
    <EmbeddedResource Include="Localization\*.json" LogicalName="RaptorSense.Localization.%(Filename).json" />
  </ItemGroup>

</Project>
